// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Auth.js (NextAuth v5) ----------

enum Role {
  ALUNO
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(ALUNO)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  profile       StudentProfile?
  studySessions StudySession[]
  answers       Answer[]
  aiUsageLogs   AIUsageLog[]
  subscriptions Subscription[]
  editais       Edital[]
  trilhas       Trilha[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- Perfil / onboarding ----------

model StudyGroup {
  id          String   @id @default(cuid())
  slug        String   @unique // "ti" | "direito"
  name        String
  description String?  @db.Text
  createdAt   DateTime @default(now())

  studentProfiles StudentProfile[]
  subjects        Subject[]
  questions       Question[]
  studySessions   StudySession[]
}

enum ThemePreference {
  CLASSICO
  GAMIFICADO
}

model StudentProfile {
  id                 String          @id @default(cuid())
  userId             String          @unique
  primaryGroupId     String?
  weeklyAvailability Json?
  dailyMinutesTarget Int?
  onboardedAt        DateTime?
  themePreference    ThemePreference @default(CLASSICO)
  xp                 Int             @default(0)
  level              Int             @default(1)
  currentStreak      Int             @default(0)
  longestStreak      Int             @default(0)
  lastStudyDate      DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  primaryGroup StudyGroup? @relation(fields: [primaryGroupId], references: [id])
  badges       UserBadge[]
}

model Badge {
  id          String @id @default(cuid())
  code        String @unique
  name        String
  description String @db.Text
  icon        String @default("🏅")

  users UserBadge[]
}

model UserBadge {
  id               String   @id @default(cuid())
  studentProfileId String
  badgeId          String
  earnedAt         DateTime @default(now())

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  badge          Badge          @relation(fields: [badgeId], references: [id])

  @@unique([studentProfileId, badgeId])
}

// ---------- Disciplinas e questões ----------

enum SubjectBlock {
  BASICO
  GERAL
  ESPECIFICO
}

model Subject {
  id        String       @id @default(cuid())
  groupId   String
  name      String
  block     SubjectBlock @default(ESPECIFICO)
  createdAt DateTime     @default(now())

  group     StudyGroup @relation(fields: [groupId], references: [id])
  questions Question[]

  @@index([groupId])
}

enum QuestionType {
  MULTIPLA_ESCOLHA
  DISCURSIVA
}

enum Difficulty {
  FACIL
  MEDIO
  DIFICIL
}

enum StudyIntensity {
  CURTA
  ALMOCO
  FOCO
}

model Question {
  id               String           @id @default(cuid())
  groupId          String
  subjectId        String?
  type             QuestionType
  difficulty       Difficulty       @default(MEDIO)
  intensity        StudyIntensity[]
  statement        String           @db.Text
  options          Json?
  correctOptionId  String?
  rubric           String?          @db.Text
  estimatedSeconds Int              @default(120)
  generatedBy      String           @default("fixture")
  isActive         Boolean          @default(true)
  examBoardId      String?
  createdAt        DateTime         @default(now())

  group     StudyGroup @relation(fields: [groupId], references: [id])
  subject   Subject?   @relation(fields: [subjectId], references: [id])
  examBoard ExamBoard? @relation(fields: [examBoardId], references: [id])
  answers   Answer[]

  @@index([groupId, subjectId, type, difficulty])
  @@index([examBoardId])
}

// ---------- Bancas examinadoras (para simulados por banca) ----------

model ExamBoard {
  id          String   @id @default(cuid())
  slug        String   @unique // "cesgranrio" | "fgv" | "cebraspe" | ...
  name        String
  description String?  @db.Text
  createdAt   DateTime @default(now())

  questions Question[]
}

// ---------- Sessões de estudo ("pílulas") ----------

enum SessionStatus {
  EM_ANDAMENTO
  FINALIZADA
  ABANDONADA
}

model StudySession {
  id              String         @id @default(cuid())
  userId          String
  groupId         String
  trilhaItemId    String?
  intensity       StudyIntensity
  status          SessionStatus  @default(EM_ANDAMENTO)
  startedAt       DateTime       @default(now())
  finishedAt      DateTime?
  scoreObjective  Float?
  scoreDiscursive Float?

  user       User        @relation(fields: [userId], references: [id])
  group      StudyGroup  @relation(fields: [groupId], references: [id])
  trilhaItem TrilhaItem? @relation(fields: [trilhaItemId], references: [id])
  answers    Answer[]

  @@index([userId, status])
}

model Answer {
  id               String    @id @default(cuid())
  sessionId        String
  questionId       String
  userId           String
  order            Int       @default(0)
  selectedOptionId String?
  textAnswer       String?   @db.Text
  isCorrect        Boolean?
  answeredAt       DateTime?
  timeSpentSeconds Int?

  session    StudySession  @relation(fields: [sessionId], references: [id])
  question   Question      @relation(fields: [questionId], references: [id])
  user       User          @relation(fields: [userId], references: [id])
  correction AICorrection?

  @@unique([sessionId, questionId])
  @@index([sessionId])
  @@index([userId])
}

model AICorrection {
  id         String   @id @default(cuid())
  answerId   String   @unique
  score      Float
  feedback   String   @db.Text
  strengths  Json?
  weaknesses Json?
  model      String
  createdAt  DateTime @default(now())

  answer Answer @relation(fields: [answerId], references: [id], onDelete: Cascade)
}

// ---------- Observabilidade de uso de IA ----------

model AIUsageLog {
  id               String   @id @default(cuid())
  userId           String?
  operation        String
  model            String
  promptTokens     Int?
  completionTokens Int?
  totalTokens      Int?
  latencyMs        Int?
  success          Boolean  @default(true)
  errorMessage     String?  @db.Text
  createdAt        DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([operation])
}

// ---------- Billing / Stripe ----------

model Plan {
  id                   String   @id @default(cuid())
  code                 String   @unique // "FREE" | "BASICO" | "PREMIUM"
  name                 String
  stripePriceId        String?
  monthlyPriceUsdCents Int?
  createdAt            DateTime @default(now())

  features      PlanFeature[]
  subscriptions Subscription[]
}

model PlanFeature {
  id     String @id @default(cuid())
  planId String
  key    String // "max_editais_ativos" | "trilha_profundidade_dias" | "correcoes_discursivas_mes"
  value  String

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, key])
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String
  planId               String
  stripeCustomerId     String?
  stripeSubscriptionId String?            @unique
  status               SubscriptionStatus @default(TRIALING)
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id])
  plan Plan @relation(fields: [planId], references: [id])

  @@index([userId, status])
}

// ---------- Editais e parsing ----------

enum EditalStatus {
  PENDENTE
  EXTRAINDO_TEXTO
  PARSEANDO_IA
  CONCLUIDO
  ERRO
}

model Edital {
  id                   String       @id @default(cuid())
  userId               String
  originalFileName     String
  blobUrl              String
  status               EditalStatus @default(PENDENTE)
  errorMessage         String?      @db.Text
  rawText              String?      @db.Text
  parsedJson           Json?
  orgao                String?
  cargo                String?
  examDate             DateTime?
  registrationDeadline DateTime?
  resultDate           DateTime?
  createdAt            DateTime     @default(now())
  parsedAt             DateTime?

  user           User                  @relation(fields: [userId], references: [id])
  subjects       EditalSubject[]
  scheduleEvents EditalScheduleEvent[]
  trilhas        Trilha[]

  @@index([userId, status])
}

model EditalSubject {
  id           String       @id @default(cuid())
  editalId     String
  block        SubjectBlock
  name         String
  numQuestions Int?
  weight       Float?

  edital Edital @relation(fields: [editalId], references: [id], onDelete: Cascade)

  @@index([editalId])
}

enum ScheduleEventKind {
  INSCRICAO
  PROVA_OBJETIVA
  PROVA_DISCURSIVA
  GABARITO
  RECURSO
  RESULTADO
  OUTRO
}

model EditalScheduleEvent {
  id        String            @id @default(cuid())
  editalId  String
  label     String
  startDate DateTime
  endDate   DateTime?
  kind      ScheduleEventKind @default(OUTRO)

  edital Edital @relation(fields: [editalId], references: [id], onDelete: Cascade)

  @@index([editalId])
}

// ---------- Trilha de estudos gerada ----------

enum TrilhaStatus {
  ATIVA
  CONCLUIDA
  ARQUIVADA
}

model Trilha {
  id         String       @id @default(cuid())
  userId     String
  editalId   String?
  title      String
  startDate  DateTime     @default(now())
  targetDate DateTime?
  status     TrilhaStatus @default(ATIVA)
  createdAt  DateTime     @default(now())

  user   User         @relation(fields: [userId], references: [id])
  edital Edital?      @relation(fields: [editalId], references: [id])
  items  TrilhaItem[]

  @@index([userId, status])
}

enum TrilhaItemStatus {
  PENDENTE
  CONCLUIDO
  PULADO
}

model TrilhaItem {
  id            String           @id @default(cuid())
  trilhaId      String
  scheduledDate DateTime
  order         Int
  subjectId     String?
  intensity     StudyIntensity   @default(CURTA)
  status        TrilhaItemStatus @default(PENDENTE)
  completedAt   DateTime?

  trilha        Trilha         @relation(fields: [trilhaId], references: [id], onDelete: Cascade)
  studySessions StudySession[]

  @@index([trilhaId, scheduledDate])
}
