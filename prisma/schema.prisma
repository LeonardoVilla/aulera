// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Auth.js (NextAuth v5) ----------

enum Role {
  ALUNO
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(ALUNO)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  profile       StudentProfile?
  studySessions StudySession[]
  answers       Answer[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- Perfil / onboarding ----------

model StudyGroup {
  id          String   @id @default(cuid())
  slug        String   @unique // "ti" | "direito"
  name        String
  description String?  @db.Text
  createdAt   DateTime @default(now())

  studentProfiles StudentProfile[]
  subjects        Subject[]
  questions       Question[]
  studySessions   StudySession[]
}

model StudentProfile {
  id                 String    @id @default(cuid())
  userId             String    @unique
  primaryGroupId     String?
  weeklyAvailability Json?
  dailyMinutesTarget Int?
  onboardedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  primaryGroup StudyGroup? @relation(fields: [primaryGroupId], references: [id])
}

// ---------- Disciplinas e questões ----------

enum SubjectBlock {
  BASICO
  GERAL
  ESPECIFICO
}

model Subject {
  id        String       @id @default(cuid())
  groupId   String
  name      String
  block     SubjectBlock @default(ESPECIFICO)
  createdAt DateTime     @default(now())

  group     StudyGroup @relation(fields: [groupId], references: [id])
  questions Question[]

  @@index([groupId])
}

enum QuestionType {
  MULTIPLA_ESCOLHA
  DISCURSIVA
}

enum Difficulty {
  FACIL
  MEDIO
  DIFICIL
}

enum StudyIntensity {
  CURTA
  ALMOCO
  FOCO
}

model Question {
  id               String           @id @default(cuid())
  groupId          String
  subjectId        String?
  type             QuestionType
  difficulty       Difficulty       @default(MEDIO)
  intensity        StudyIntensity[]
  statement        String           @db.Text
  options          Json?
  correctOptionId  String?
  rubric           String?          @db.Text
  estimatedSeconds Int              @default(120)
  generatedBy      String           @default("fixture")
  isActive         Boolean          @default(true)
  createdAt        DateTime         @default(now())

  group   StudyGroup @relation(fields: [groupId], references: [id])
  subject Subject?   @relation(fields: [subjectId], references: [id])
  answers Answer[]

  @@index([groupId, subjectId, type, difficulty])
}

// ---------- Sessões de estudo ("pílulas") ----------

enum SessionStatus {
  EM_ANDAMENTO
  FINALIZADA
  ABANDONADA
}

model StudySession {
  id              String         @id @default(cuid())
  userId          String
  groupId         String
  intensity       StudyIntensity
  status          SessionStatus  @default(EM_ANDAMENTO)
  startedAt       DateTime       @default(now())
  finishedAt      DateTime?
  scoreObjective  Float?
  scoreDiscursive Float?

  user    User       @relation(fields: [userId], references: [id])
  group   StudyGroup @relation(fields: [groupId], references: [id])
  answers Answer[]

  @@index([userId, status])
}

model Answer {
  id               String    @id @default(cuid())
  sessionId        String
  questionId       String
  userId           String
  order            Int       @default(0)
  selectedOptionId String?
  textAnswer       String?   @db.Text
  isCorrect        Boolean?
  answeredAt       DateTime?
  timeSpentSeconds Int?

  session  StudySession @relation(fields: [sessionId], references: [id])
  question Question     @relation(fields: [questionId], references: [id])
  user     User         @relation(fields: [userId], references: [id])

  @@unique([sessionId, questionId])
  @@index([sessionId])
  @@index([userId])
}
