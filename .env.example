# Database (Neon)
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
DIRECT_URL="postgresql://user:password@host/db?sslmode=require"

# Auth.js (NextAuth v5)
AUTH_SECRET="generate-with: npx auth secret"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Microsoft Entra ID (opcional — login com conta Microsoft/Outlook).
# Deixe em branco para desativar esse botão de login.
# Callback URL a cadastrar no Azure Portal: http://localhost:3000/api/auth/callback/microsoft-entra-id
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""

# Gemini API (provedor principal de IA)
GEMINI_API_KEY=""

# OpenAI API (opcional — fallback automático quando o Gemini atingir o
# limite de quota/rate limit; deixe em branco para desativar o fallback)
OPENAI_API_KEY=""

# Stripe (use test keys until billing goes live)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_BASICO="price_..."
STRIPE_PRICE_PREMIUM="price_..."

# Vercel Blob
BLOB_READ_WRITE_TOKEN=""

# App
ENCRYPTION_SECRET="generate a 32-byte random secret for AES-256-GCM"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
